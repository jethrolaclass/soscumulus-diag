{
  "name": "soscumulus-diag",
  "private": true,
  "version": "0.1.0",
  "description": "SOS Diag Express \u2014 diagnostic \u00e0 distance de chauffe-eau \u00e0 partir de 3 photos",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=web",
    "deploy:api": "wrangler deploy --config api/wrangler.toml",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:api": "tsc --noEmit --project api/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
